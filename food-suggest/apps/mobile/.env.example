# Copy to .env.local (git-ignored). All EXPO_PUBLIC_ values are bundled into the app: never put secrets here.

# Optional: API address. In development the app finds your computer automatically.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# Supabase project URL and PUBLISHABLE key (Project Settings → API Keys). Not the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
