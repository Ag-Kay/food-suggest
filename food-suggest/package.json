{
  "name": "food-suggest",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @food-suggest/api dev",
    "dev:mobile": "pnpm --filter @food-suggest/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
