# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local development database from `pnpm db:dev` (Prisma's built-in local Postgres).
# The ports are printed when it starts; these are the defaults it chose on first run.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0

# USDA FoodData Central (free): https://fdc.nal.usda.gov/api-key-signup
# Only needed to fetch new USDA foods (`pnpm fdc:fetch`). Saved foods are committed.
USDA_FDC_API_KEY=

# Supabase (accounts). Leave empty to run without sign-in.
# Project Settings → API Keys. The SECRET key is server-only: never put it in the app or in git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Meal photos in our own Supabase Storage. Run `pnpm photos:upload` (needs the two values above),
# then set this to the URL it prints and re-run the seed. Empty = load photos from their sources.
# e.g. https://<project>.supabase.co/storage/v1/object/public/meal-photos
MEAL_PHOTOS_BASE_URL=

# --- Added in later milestones ---
# GROQ_API_KEY=
